{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source for Soroban Explorer metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Gas fee alert snapshot evaluation, webhook delivery SLO, and error budget. The 100ms event-to-client target is not yet sustained-load validated. See docs/GAS_FEE_ALERTS.md.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(increase(gas_fee_alert_delivery_attempts_total{outcome=\"success\"}[30d])) / clamp_min(sum(increase(gas_fee_alert_delivery_attempts_total{outcome=~\"success|http_error|network_error|ssrf_blocked\"}[30d])), 1)", "legendFormat": "successful attempts", "refId": "A" }],
      "title": "30-day delivery success (objective 99.5%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.5 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "clamp_min(1 - ((sum(increase(gas_fee_alert_delivery_attempts_total{outcome=~\"http_error|network_error|ssrf_blocked\"}[30d])) / clamp_min(sum(increase(gas_fee_alert_delivery_attempts_total{outcome=~\"success|http_error|network_error|ssrf_blocked\"}[30d])), 1)) / 0.005), 0)", "legendFormat": "budget remaining", "refId": "A" }],
      "title": "30-day error budget remaining (0.5%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(gas_fee_alert_event_to_delivery_seconds_bucket[10m])))", "legendFormat": "p99", "refId": "A" }],
      "title": "Event-to-client p99 (target <100ms; unvalidated)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "targets": [{ "expr": "sum by (outcome) (rate(gas_fee_alert_delivery_attempts_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }],
      "title": "Webhook delivery attempts by outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "targets": [
        { "expr": "sum by (outcome) (rate(gas_fee_alert_evaluator_operations_total[5m]))", "legendFormat": "evaluation / {{outcome}}", "refId": "A" },
        { "expr": "sum by (outcome) (rate(gas_fee_alert_outbox_operations_total[5m]))", "legendFormat": "outbox / {{outcome}}", "refId": "B" },
        { "expr": "sum by (operation, outcome) (rate(gas_fee_alert_api_operations_total[5m]))", "legendFormat": "api / {{operation}} / {{outcome}}", "refId": "C" }
      ],
      "title": "API, snapshot evaluation, and outbox outcomes",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["gas-fees", "alerts", "reliability", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Gas Fee Alerts",
  "uid": "gas-fee-alerts",
  "version": 1
}