{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source for Soroban Explorer metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "Batch webhook latency, delivery error budget, queue depth, and batching. SLOs and operating steps: docs/webhook-batch-delivery-runbook.md.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "1 - (sum(increase(webhook_batch_operations_total{operation=\"delivery\",outcome=~\"http_error|retry|ssrf_blocked|payload_too_large\"}[30d])) / clamp_min(sum(increase(webhook_batch_operations_total{operation=\"delivery\",outcome=~\"success|http_error|retry|ssrf_blocked|payload_too_large\"}[30d])), 1))",
          "legendFormat": "successful attempts",
          "refId": "A"
        }
      ],
      "title": "30-day delivery success (SLO 99.9%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "1 - ((sum(increase(webhook_batch_operations_total{operation=\"delivery\",outcome=~\"http_error|retry|ssrf_blocked|payload_too_large\"}[30d])) / clamp_min(sum(increase(webhook_batch_operations_total{operation=\"delivery\",outcome=~\"success|http_error|retry|ssrf_blocked|payload_too_large\"}[30d])), 1)) / 0.001)",
          "legendFormat": "remaining budget",
          "refId": "A"
        }
      ],
      "title": "30-day error budget remaining (0.1%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(webhook_event_to_delivery_seconds_bucket{mode=\"batch\"}[5m])) by (le))",
          "legendFormat": "p99 event-to-client",
          "refId": "A"
        }
      ],
      "title": "p99 event-to-client latency (target <100 ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "targets": [
        { "expr": "webhook_outbox_events", "legendFormat": "pending + in flight", "refId": "A" }
      ],
      "title": "Durable outbox depth (per-subscription ceiling: 50,000)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "targets": [
        { "expr": "sum by (outcome) (rate(webhook_batch_operations_total{operation=\"delivery\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ],
      "title": "Delivery attempt outcomes per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "id": 6,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(webhook_batch_events_bucket[5m])) by (le))", "legendFormat": "p50 events", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum(rate(webhook_batch_events_bucket[5m])) by (le))", "legendFormat": "p99 events", "refId": "B" }
      ],
      "title": "Batch size distribution",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["webhooks", "reliability", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Webhook Batch Delivery",
  "uid": "webhook-batch-delivery",
  "version": 1
}